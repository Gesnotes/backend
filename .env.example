NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://user:password@localhost:5432/gesnotes"

# Au moins 32 caractères. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="a-remplacer-par-un-secret-aleatoire-de-32-caracteres-minimum"
ACCESS_TOKEN_TTL=30d
REFRESH_TOKEN_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=60

# console = n'envoie rien, affiche l'email dans les logs (defaut en dev)
# resend  = envoi reel, necessite RESEND_API_KEY
MAILER=console
RESEND_API_KEY=""
MAIL_FROM="onboarding@resend.dev"

# Racine publique de l API elle-meme.
APP_BASE_URL="http://localhost:3000"

# Racine de l application web, celle ouverte dans le navigateur.
# Les liens de reinitialisation et d invitation pointent ici : viser l API
# donnerait un 404 a chaque destinataire. Repli sur APP_BASE_URL si absente.
WEB_APP_URL="http://localhost:5173"

# Nombre de reverse proxies devant l'app. LAISSER A 0 si l'app est exposee
# directement : sinon X-Forwarded-For est cru sur parole et le rate-limit du
# login se contourne avec un en-tete forge.
TRUST_PROXY_HOPS=0

# Duree de validite du lien d invitation d un compte cree par l admin
INVITATION_TTL_HOURS=72

# Notifications push.
# console = n'envoie rien, trace le message (defaut en dev et en test)
# fcm     = envoi reel via le SDK Admin Firebase
#
# ATTENTION : ces trois valeurs viennent du COMPTE DE SERVICE
# (Firebase Console > Parametres > Comptes de service > Generer une cle privee),
# PAS de la configuration web du frontend. L'apiKey et la cle VAPID du client
# vivent dans le navigateur et ne permettent pas d'envoyer une notification.
PUSH=console
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Les sauts de ligne restent en \n litteraux, la valeur entre guillemets.
FIREBASE_PRIVATE_KEY=""

# ================================================== Suivi des erreurs
# GlitchTip (ou tout serveur compatible Sentry). Vide = desactive, sans
# le moindre effet sur l application.
#
# Demarrer le serveur local :
#   docker compose -f docker-compose.glitchtip.yml up -d
# Puis http://localhost:8000, creer le projet et copier son DSN ici.
# Marche a suivre : docs/MONITORING.md
SENTRY_DSN=

# Etiquette affichee dans le tableau de bord (defaut : NODE_ENV).
SENTRY_ENVIRONMENT=

# Part des requetes tracees pour la performance, entre 0 et 1.
# 0 par defaut : GlitchTip stocke chaque transaction, et tout tracer
# remplit la base pour un benefice nul sur un petit etablissement.
SENTRY_TRACES_SAMPLE_RATE=0
