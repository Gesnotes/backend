NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://user:password@localhost:5432/gesnotes"

# Au moins 32 caractères. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="a-remplacer-par-un-secret-aleatoire-de-32-caracteres-minimum"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=60

# console = n'envoie rien, affiche l'email dans les logs (defaut en dev)
# resend  = envoi reel, necessite RESEND_API_KEY
MAILER=console
RESEND_API_KEY=""
MAIL_FROM="onboarding@resend.dev"

APP_BASE_URL="http://localhost:3000"

# Repli hors production : en local, req.hostname vaut "localhost" et ne
# resout aucune ecole. Surchargeable par l'en-tete X-School-Subdomain.
DEFAULT_SCHOOL_SUBDOMAIN="ecole-demo"
