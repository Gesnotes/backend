generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  teacher
  parent

  @@map("role")
}

// Établissements
model School {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(150)
  subdomain String    @unique @db.VarChar(63) // "ecole-x" dans ecole-x.gesnotes.app
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  users      User[]
  terms      Term[]
  classes    Class[]
  subjects   Subject[]
  students   Student[]
  gradeTypes GradeType[]

  @@map("schools")
}

// Utilisateurs (admin, prof, parent — un seul point d'auth)
model User {
  id           Int       @id @default(autoincrement())
  schoolId     Int       @map("school_id")
  email        String    @db.VarChar(150)
  phone        String?   @db.VarChar(30)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         Role
  firstName    String?   @map("first_name") @db.VarChar(100)
  lastName     String?   @map("last_name") @db.VarChar(100)
  archivedAt   DateTime? @map("archived_at") @db.Timestamp(6)
  /// Coupe les access tokens émis avant cette date. Indispensable avec des
  /// tokens longue durée : un JWT est stateless, seule cette borne permet de
  /// déconnecter réellement (logout, archivage, changement de mot de passe).
  sessionsRevokedAt DateTime? @map("sessions_revoked_at") @db.Timestamp(6)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  school         School               @relation(fields: [schoolId], references: [id])
  children       StudentParent[]
  assignments    TeacherAssignment[]
  grades         Grade[]
  evaluations    Evaluation[]
  devices        Device[]
  refreshTokens  RefreshToken[]
  resetTokens    PasswordResetToken[]

  // Unicité par école, pas globalement : la même personne peut être parent
  // dans deux établissements clients distincts, et une collision d'email
  // entre écoles ne doit pas fuiter d'un tenant à l'autre.
  @@unique([id, schoolId])
  @@unique([schoolId, email])
  @@unique([schoolId, phone])
  @@index([schoolId, archivedAt])
  @@map("users")
}

// Refresh tokens — permet l'invalidation côté serveur (POST /auth/logout)
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

// Tokens de réinitialisation de mot de passe (usage unique, expirants)
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  usedAt    DateTime? @map("used_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("password_reset_tokens")
}

// Année scolaire / période (trimestre, semestre)
model Term {
  id        Int       @id @default(autoincrement())
  schoolId  Int       @map("school_id")
  label     String    @db.VarChar(50) // "Trimestre 1", "2025-2026"
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  // Une période portant des évaluations ne peut pas être effacée directement :
  // `evaluations.term_id` et `grades.term_id` sont en RESTRICT. L'archivage la
  // sort des sélecteurs sans rien détruire ; la suppression définitive se fait
  // depuis les archives, en connaissance de cause.
  archivedAt DateTime? @map("archived_at") @db.Timestamp(6)
  // Instant jusqu'auquel la saisie reste ouverte sur une période pourtant
  // terminée. Une correction de dernière minute ne doit pas obliger
  // l'administration à ressaisir à la place de l'enseignant, ni à repousser la
  // date de fin du trimestre — ce qui fausserait « période en cours ».
  // L'échéance est portée par la période plutôt que par une table
  // d'autorisations nominatives : le besoin réel est de rouvrir un trimestre
  // pour l'équipe le temps d'un rattrapage, et le verrou se remet seul.
  reopenedUntil DateTime? @map("reopened_until") @db.Timestamp(6)

  school      School       @relation(fields: [schoolId], references: [id])
  grades      Grade[]
  evaluations Evaluation[]

  @@index([schoolId, archivedAt])
  @@map("terms")
}

// Classes
model Class {
  id         Int       @id @default(autoincrement())
  schoolId   Int       @map("school_id")
  name       String    @db.VarChar(50) // "6e A"
  level      String    @db.VarChar(20) // "6e" — gabarit de coefficients, jamais utilisé dans le calcul
  archivedAt DateTime? @map("archived_at") @db.Timestamp(6)

  school       School               @relation(fields: [schoolId], references: [id])
  students     Student[]
  assignments  TeacherAssignment[]
  coefficients SubjectCoefficient[]
  evaluations  Evaluation[]

  // Cible des clés étrangères composites de TeacherAssignment.
  @@unique([id, schoolId])
  @@index([schoolId, archivedAt])
  @@map("classes")
}

// Matières
model Subject {
  id          Int       @id @default(autoincrement())
  schoolId    Int       @map("school_id")
  name        String    @db.VarChar(100)
  coefficient Decimal?  @default(1) @db.Decimal(4, 2) // défaut école, surchargé par SubjectCoefficient
  archivedAt  DateTime? @map("archived_at") @db.Timestamp(6)

  school       School               @relation(fields: [schoolId], references: [id])
  assignments  TeacherAssignment[]
  grades       Grade[]
  coefficients SubjectCoefficient[]
  evaluations  Evaluation[]

  // Cible des clés étrangères composites de TeacherAssignment.
  @@unique([id, schoolId])
  @@index([schoolId, archivedAt])
  @@map("subjects")
}

// Coefficient d'une matière pour une classe donnée.
// La clé composite interdit structurellement le doublon.
model SubjectCoefficient {
  subjectId   Int     @map("subject_id")
  classId     Int     @map("class_id")
  coefficient Decimal @db.Decimal(4, 2)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([subjectId, classId])
  @@map("subject_coefficients")
}

// Types de note et leur poids — configurable par école, jamais codé en dur.
// interrogation = 1, devoir = 2, composition = 3 (seed par défaut).
model GradeType {
  id       Int     @id @default(autoincrement())
  schoolId Int     @map("school_id")
  code     String  @db.VarChar(30) // "interrogation" | "devoir" | "composition"
  label    String  @db.VarChar(50)
  weight   Decimal @db.Decimal(4, 2)
  position Int     @default(0)

  school      School       @relation(fields: [schoolId], references: [id])
  grades      Grade[]
  evaluations Evaluation[]

  @@unique([schoolId, code])
  @@map("grade_types")
}

// Élèves
model Student {
  id         Int       @id @default(autoincrement())
  schoolId   Int       @map("school_id")
  classId    Int       @map("class_id")
  firstName  String    @map("first_name") @db.VarChar(100)
  lastName   String    @map("last_name") @db.VarChar(100)
  birthDate  DateTime? @map("birth_date") @db.Date
  archivedAt DateTime? @map("archived_at") @db.Timestamp(6)

  school  School          @relation(fields: [schoolId], references: [id])
  class   Class           @relation(fields: [classId], references: [id])
  parents StudentParent[]
  grades  Grade[]

  // Cible de la clé étrangère composite de Grade : garantit en base qu'une
  // note et son élève appartiennent à la même école.
  @@unique([id, schoolId])
  @@index([classId, archivedAt])
  @@index([schoolId, archivedAt])
  @@map("students")
}

// Lien élève ↔ parent (un enfant peut avoir plusieurs parents/tuteurs)
model StudentParent {
  studentId    Int @map("student_id")
  parentUserId Int @map("parent_user_id")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  User    @relation(fields: [parentUserId], references: [id], onDelete: Cascade)

  @@id([studentId, parentUserId])
  @@map("student_parents")
}

// Affectation prof ↔ classe ↔ matière
//
// `schoolId` est dénormalisé et partagé par les trois clés étrangères
// composites : la base refuse désormais une affectation qui mélangerait un
// enseignant, une classe et une matière de deux établissements. Sans cela,
// les trois FK étaient indépendantes et seul un contrôle applicatif
// empêchait la ligne croisée — alors que `listMyClasses` en dérive les
// classes qu'un professeur a le droit de voir.
model TeacherAssignment {
  id            Int @id @default(autoincrement())
  schoolId      Int @map("school_id")
  teacherUserId Int @map("teacher_user_id")
  classId       Int @map("class_id")
  subjectId     Int @map("subject_id")

  teacher User    @relation(fields: [teacherUserId, schoolId], references: [id, schoolId], onDelete: Cascade)
  class   Class   @relation(fields: [classId, schoolId], references: [id, schoolId], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@unique([teacherUserId, classId, subjectId])
  @@index([schoolId])
  @@map("teacher_assignments")
}

// Appareils des utilisateurs (tokens push FCM) — un parent peut en avoir plusieurs
model Device {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  fcmToken  String    @unique @map("fcm_token") @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("devices")
}

// Notes.
// Le poids d'une note vient UNIQUEMENT de GradeType.weight : il n'y a
// volontairement pas de colonne `coefficient` ici (source de vérité unique).
model Grade {
  id            Int       @id @default(autoincrement())
  schoolId      Int       @map("school_id") // dénormalisé : isolation multi-écoles sans jointure
  studentId     Int       @map("student_id")
  evaluationId  Int       @map("evaluation_id")
  subjectId     Int       @map("subject_id")
  gradeTypeId   Int       @map("grade_type_id")
  termId        Int       @map("term_id")
  teacherUserId Int?      @map("teacher_user_id")
  value         Decimal   @db.Decimal(5, 2)
  // Recopié depuis l'évaluation, qui en est la source de vérité. Dénormalisé
  // ici comme school_id l'est plus haut : le calcul des moyennes lit la note
  // sans jointure sur l'évaluation. Toute écriture passe par le barème de
  // l'évaluation, ce qui garde les deux alignés.
  maxValue      Decimal   @default(20) @map("max_value") @db.Decimal(5, 2)
  comment       String?   @db.Text // commentaire du prof, visible par le parent
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  // Clé composite : impossible d'enregistrer une note dont le school_id
  // dénormalisé diverge de celui de l'élève. Sans cela, la colonne qui porte
  // tout le filtrage d'isolation ne serait garantie par rien.
  student    Student    @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id])
  gradeType  GradeType  @relation(fields: [gradeTypeId], references: [id])
  term       Term       @relation(fields: [termId], references: [id])
  teacher    User?      @relation(fields: [teacherUserId], references: [id])

  // Une seule note par élève et par évaluation : l'ambiguïté « plusieurs notes
  // du même type » disparaît, l'identité d'une note étant désormais son
  // évaluation, non son type.
  @@unique([evaluationId, studentId])
  @@index([studentId, termId]) // porte tout le calcul des moyennes
  @@index([schoolId, createdAt]) // porte le dashboard admin
  @@index([subjectId, termId])
  @@map("grades")
}

// Une évaluation concrète : « Interro du 12/09 », « Composition du 2e trimestre ».
//
// C'est elle qui permet plusieurs notes du même type dans une même période :
// deux interrogations sont deux évaluations distinctes, chacune portant son
// libellé, sa date et son barème. Le poids reste porté par le type de note.
model Evaluation {
  id            Int       @id @default(autoincrement())
  schoolId      Int       @map("school_id")
  classId       Int       @map("class_id")
  subjectId     Int       @map("subject_id")
  gradeTypeId   Int       @map("grade_type_id")
  termId        Int       @map("term_id")
  teacherUserId Int?      @map("teacher_user_id")
  label         String    @db.VarChar(120)
  date          DateTime? @db.Date
  maxValue      Decimal   @default(20) @map("max_value") @db.Decimal(5, 2)
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  // Comme Grade s'ancre à son école via l'élève, l'évaluation s'y ancre via sa
  // classe : la clé composite interdit une évaluation dont le school_id diverge
  // de celui de la classe.
  class     Class     @relation(fields: [classId, schoolId], references: [id, schoolId], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id])
  gradeType GradeType @relation(fields: [gradeTypeId], references: [id])
  term      Term      @relation(fields: [termId], references: [id])
  teacher   User?     @relation(fields: [teacherUserId], references: [id])
  grades    Grade[]

  @@index([classId, subjectId, termId])
  @@index([schoolId])
  @@map("evaluations")
}
