generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  teacher
  parent

  @@map("role")
}

enum Sex {
  M
  F

  @@map("sex")
}


// Établissements
model School {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(150)
  // Sert à désambiguïser deux écoles de même nom à la connexion (identifiant
  // valable dans plusieurs écoles à la fois) : la liste de choix affiche la
  // ville. Nullable : les écoles existantes n'en ont pas encore.
  city      String?   @db.VarChar(100)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  /// Suspension par l'équipe Gesnotes (impayé, litige, fermeture...) : les
  /// comptes de l'école ne peuvent plus se connecter, mais rien n'est détruit
  /// — voir `staff.service.ts` (suspendSchool/restoreSchool). Distinct d'une
  /// suppression définitive, qui reste soumise au retapage du nom exact.
  archivedAt DateTime? @map("archived_at") @db.Timestamp(6)
  /// Moyenne à partir de laquelle l'école considère un élève admis dans une
  /// matière. Purement déclaratif : le calcul de la moyenne elle-même
  /// (compute.ts) ne s'en sert pas, seul l'affichage en tient compte.
  passingGrade Decimal @default(10) @map("passing_grade") @db.Decimal(4, 2)
  /// Coordonnées affichées dans Paramètres — purement déclaratives, sans
  /// validation d'unicité ni d'usage ailleurs dans l'app (contrairement à
  /// l'email/téléphone d'un `User`, qui servent à la connexion).
  email   String? @db.VarChar(150)
  phone   String? @db.VarChar(30)
  address String? @db.VarChar(255)
  /// Personnalisation du bulletin PDF par image téléversée (en-tête officiel,
  /// logo, cachet... — un rendu texte ne convient pas à une mise en forme déjà
  /// figée). PNG ou JPEG uniquement (contrainte de pdfkit, voir bulletin/pdf.ts).
  /// Optionnelles : sans elles, le bulletin garde son rendu par défaut.
  bulletinHeaderImage     Bytes?  @map("bulletin_header_image")
  bulletinHeaderImageType String? @map("bulletin_header_image_type") @db.VarChar(50)
  bulletinFooterImage     Bytes?  @map("bulletin_footer_image")
  bulletinFooterImageType String? @map("bulletin_footer_image_type") @db.VarChar(50)

  users          User[]
  schoolYears    SchoolYear[]
  terms          Term[]
  classes        Class[]
  subjects       Subject[]
  students       Student[]
  gradeTypes     GradeType[]
  signupRequests SignupRequest[]
  holidays       Holiday[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  notificationRecipients NotificationRecipient[]

  @@index([archivedAt])
  @@map("schools")
}

enum SignupRequestStatus {
  nouveau
  traite

  @@map("signup_request_status")
}

/// Demande de rappel du formulaire public d'inscription (inscription
/// hybride, plan §1) : aucune école ni aucun compte n'existe encore à ce
/// stade. Le formulaire capte la demande, l'équipe Gesnotes configure
/// ensuite l'école et son administration au téléphone. Seule table du schéma
/// qui n'appartient à aucune école — elle en précède l'existence.
model SignupRequest {
  id          Int                 @id @default(autoincrement())
  schoolName  String              @map("school_name") @db.VarChar(150)
  contactName String              @map("contact_name") @db.VarChar(150)
  // Seul moyen de recontacter l'école si l'appel manque le téléphone, et sert
  // à préremplir l'invitation du premier compte administrateur à l'acceptation.
  email       String              @db.VarChar(150)
  phone       String              @db.VarChar(30)
  city        String              @db.VarChar(100)
  // Niveaux cochés dans le formulaire ("maternelle", "primaire", ...), en
  // texte libre côté saisie : la liste des niveaux n'est pas un référentiel
  // fermé dans le reste de l'application.
  levels      String[]
  status      SignupRequestStatus @default(nouveau)
  // Renseigné à l'acceptation (staff.service.ts) : l'école réellement créée à
  // partir de cette demande, pour retrouver d'où vient chaque école.
  schoolId    Int?                @map("school_id")
  createdAt   DateTime?           @default(now()) @map("created_at") @db.Timestamp(6)

  school School? @relation(fields: [schoolId], references: [id])

  @@index([status, createdAt])
  @@map("signup_requests")
}

/// Comptes de l'équipe Gesnotes, hors du périmètre multi-écoles : n'appartient
/// à aucune école, ne porte pas de rôle métier (admin/teacher/parent). Sert à
/// superviser la plateforme et à traiter les demandes d'inscription. Créé à
/// la main pour l'instant (script) : pas de self-service, n'importe qui
/// pourrait sinon s'auto-inscrire comme membre de l'équipe.
model StaffUser {
  id                Int       @id @default(autoincrement())
  email             String    @unique @db.VarChar(150)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  firstName         String?   @map("first_name") @db.VarChar(100)
  lastName          String?   @map("last_name") @db.VarChar(100)
  archivedAt        DateTime? @map("archived_at") @db.Timestamp(6)
  /// Même rôle que `User.sessionsRevokedAt` : coupe les access tokens déjà
  /// émis, le seul moyen de déconnecter réellement un JWT longue durée.
  sessionsRevokedAt DateTime? @map("sessions_revoked_at") @db.Timestamp(6)
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  refreshTokens StaffRefreshToken[]
  resetTokens   StaffPasswordResetToken[]

  @@map("staff_users")
}

// Refresh tokens du staff — table dédiée plutôt que réutiliser `RefreshToken`
// (qui référence `User`) : un compte staff n'est pas un `User` d'école.
model StaffRefreshToken {
  id          Int       @id @default(autoincrement())
  staffUserId Int       @map("staff_user_id")
  tokenHash   String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt   DateTime  @map("expires_at") @db.Timestamp(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId, revokedAt])
  @@map("staff_refresh_tokens")
}

// Miroir de `PasswordResetToken`, table dédiée pour la même raison que
// `StaffRefreshToken` : un compte staff n'est pas un `User` d'école.
model StaffPasswordResetToken {
  id          Int       @id @default(autoincrement())
  staffUserId Int       @map("staff_user_id")
  tokenHash   String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt   DateTime  @map("expires_at") @db.Timestamp(6)
  usedAt      DateTime? @map("used_at") @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  @@index([staffUserId, usedAt])
  @@map("staff_password_reset_tokens")
}

// Année scolaire ("2025-2026") — regroupe les périodes (trimestres,
// semestres) d'une même rentrée. Le rattachement d'une période est optionnel :
// une période sans année continue de fonctionner exactement comme avant,
// aucune migration de données n'est nécessaire pour les écoles déjà en
// production.
model SchoolYear {
  id         Int       @id @default(autoincrement())
  schoolId   Int       @map("school_id")
  label      String    @db.VarChar(50) // "2025-2026"
  startDate  DateTime? @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  // Comme pour une période : archiver plutôt qu'effacer, la suppression
  // définitive restant une décision distincte prise depuis les archives.
  archivedAt DateTime? @map("archived_at") @db.Timestamp(6)

  school  School  @relation(fields: [schoolId], references: [id])
  terms   Term[]
  classes Class[]

  @@index([schoolId, archivedAt])
  @@map("school_years")
}

// Utilisateurs (admin, prof, parent — un seul point d'auth)
model User {
  id                Int       @id @default(autoincrement())
  schoolId          Int       @map("school_id")
  email             String    @db.VarChar(150)
  phone             String?   @db.VarChar(30)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  role              Role
  firstName         String?   @map("first_name") @db.VarChar(100)
  lastName          String?   @map("last_name") @db.VarChar(100)
  archivedAt        DateTime? @map("archived_at") @db.Timestamp(6)
  /// Coupe les access tokens émis avant cette date. Indispensable avec des
  /// tokens longue durée : un JWT est stateless, seule cette borne permet de
  /// déconnecter réellement (logout, archivage, changement de mot de passe).
  sessionsRevokedAt DateTime? @map("sessions_revoked_at") @db.Timestamp(6)
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  school              School               @relation(fields: [schoolId], references: [id])
  children            StudentParent[]
  assignments         TeacherAssignment[]
  grades              Grade[]
  evaluations         Evaluation[]
  devices             Device[]
  refreshTokens       RefreshToken[]
  resetTokens         PasswordResetToken[]
  homeroomClasses     Class[]
  attendancesRecorded Attendance[]
  enrollmentDecisions EnrollmentDecision[]
  linkedAccounts      AccountLink[]        @relation("AccountLinkOwner")
  linkedBy            AccountLink[]        @relation("AccountLinkLinked")
  auditLogsAsActor    AuditLog[]
  notificationsCreated Notification[]
  notificationRecipients NotificationRecipient[] @relation("NotificationRecipients")

  // Unicité par école, pas globalement : la même personne peut être parent
  // dans deux établissements clients distincts, et une collision d'email
  // entre écoles ne doit pas fuiter d'un tenant à l'autre.
  @@unique([id, schoolId])
  @@unique([schoolId, email])
  @@unique([schoolId, phone])
  @@index([schoolId, archivedAt])
  @@map("users")
}

// Refresh tokens — permet l'invalidation côté serveur (POST /auth/logout)
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

/// Liaison explicite entre deux comptes `User` distincts appartenant à la
/// même personne réelle — cas qu'`identify()` ne peut pas détecter seul
/// (identifiants différents, ex. un enseignant qui est aussi parent dans la
/// même école, ou dans une autre avec un email différent). Toujours créée en
/// double ligne symétrique (A→B et B→A) pour que la bascule fonctionne dans
/// les deux sens sans requête supplémentaire.
model AccountLink {
  id           Int      @id @default(autoincrement())
  ownerUserId  Int      @map("owner_user_id")
  linkedUserId Int      @map("linked_user_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  owner  User @relation("AccountLinkOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  linked User @relation("AccountLinkLinked", fields: [linkedUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, linkedUserId])
  @@map("account_links")
}

// Tokens de réinitialisation de mot de passe (usage unique, expirants)
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  usedAt    DateTime? @map("used_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("password_reset_tokens")
}

// Période (trimestre, semestre) — le regroupement par année scolaire vit sur
// `SchoolYear`, `schoolYearId` ci-dessous.
model Term {
  id            Int       @id @default(autoincrement())
  schoolId      Int       @map("school_id")
  // Nullable : rattacher une période à une année scolaire est optionnel,
  // voir le commentaire sur `SchoolYear`.
  schoolYearId  Int?      @map("school_year_id")
  label         String    @db.VarChar(50) // "Trimestre 1", "2025-2026"
  startDate     DateTime? @map("start_date") @db.Date
  endDate       DateTime? @map("end_date") @db.Date
  // L'archivage sort la période des sélecteurs sans rien détruire ; la
  // suppression définitive (depuis les archives, libellé exact retapé) emporte
  // en cascade ses évaluations et ses notes — voir `deleteTermPermanently`.
  archivedAt    DateTime? @map("archived_at") @db.Timestamp(6)
  // Instant jusqu'auquel la saisie reste ouverte sur une période pourtant
  // terminée. Une correction de dernière minute ne doit pas obliger
  // l'administration à ressaisir à la place de l'enseignant, ni à repousser la
  // date de fin du trimestre — ce qui fausserait « période en cours ».
  // L'échéance est portée par la période plutôt que par une table
  // d'autorisations nominatives : le besoin réel est de rouvrir un trimestre
  // pour l'équipe le temps d'un rattrapage, et le verrou se remet seul.
  reopenedUntil DateTime? @map("reopened_until") @db.Timestamp(6)

  school      School       @relation(fields: [schoolId], references: [id])
  // Cascade : supprimer une année scolaire pour de bon emporte ses périodes
  // (voir `deleteSchoolYearPermanently`).
  schoolYear  SchoolYear?  @relation(fields: [schoolYearId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  grades      Grade[]
  evaluations Evaluation[]

  @@index([schoolId, archivedAt])
  @@index([schoolYearId])
  @@map("terms")
}

// Jour férié ou de congé, exclu du calcul « classes sans appel » du tableau
// de bord (voir `getAttendanceSummary`) : sans appel un jour férié n'est pas
// un oubli à relancer. Pas de contrainte unique en base sur (school_id,
// date) — comme pour Term, le chevauchement n'est contrôlé qu'entre jours
// actifs (`assertNoDuplicateDate`), pour ne pas bloquer la recréation d'un
// jour après archivage d'un doublon.
model Holiday {
  id         Int       @id @default(autoincrement())
  schoolId   Int       @map("school_id")
  date       DateTime  @db.Date
  label      String    @db.VarChar(150)
  archivedAt DateTime? @map("archived_at") @db.Timestamp(6)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, date])
  @@map("holidays")
}

// Journal d'audit, volontairement borné à un petit nombre d'actions
// sensibles (note modifiée/supprimée, élève déplacé de classe, compte
// archivé/restauré/supprimé définitivement — voir `audit.service.ts`), pas
// une trace générique de toute mutation. `actorName`/`actorRole` sont figés
// à l'écriture : un acteur supprimé plus tard (suppression définitive d'un
// compte) ne doit pas faire disparaître qui a fait quoi. `targetId` n'est
// volontairement pas une clé étrangère : l'entité visée (note, élève...)
// peut elle-même avoir disparu depuis, l'entrée du journal doit survivre.
model AuditLog {
  id          Int      @id @default(autoincrement())
  schoolId    Int      @map("school_id")
  actorUserId Int?     @map("actor_user_id")
  actorName   String   @map("actor_name") @db.VarChar(150)
  actorRole   Role     @map("actor_role")
  action      String   @db.VarChar(50)
  targetType  String   @map("target_type") @db.VarChar(50)
  targetId    Int?     @map("target_id")
  targetLabel String?  @map("target_label") @db.VarChar(255)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@map("audit_logs")
}

// Mode de fonctionnement d'une classe : `notes` pour le suivi habituel
// (évaluations chiffrées), `presence` pour la maternelle/garderie où seule la
// présence compte. Les deux sont mutuellement exclusifs — voir le garde-fou
// dans evaluation.service.ts.
enum ClassMode {
  notes
  presence

  @@map("class_mode")
}

// Classes
model Class {
  id                Int       @id @default(autoincrement())
  schoolId          Int       @map("school_id")
  name              String    @db.VarChar(50) // "6e A"
  level             String    @db.VarChar(20) // "6e" — gabarit de coefficients, jamais utilisé dans le calcul
  mode              ClassMode @default(notes)
  // Seul enseignant, avec l'admin, autorisé à saisir la présence de cette
  // classe (plan maternelle/garderie). `null` : seul l'admin peut saisir.
  homeroomTeacherId Int?      @map("homeroom_teacher_id")
  // Nullable, comme `Term.schoolYearId` : une classe non rattachée continue de
  // fonctionner exactement comme avant. Le nom d'une classe n'est unique que
  // dans son année (ou parmi les classes sans année) — voir
  // `assertClassNameAvailable` — pour qu'une « 6e A » puisse revenir chaque
  // rentrée sans entrer en conflit avec elle-même l'an passé.
  schoolYearId      Int?      @map("school_year_id")
  // Classe où les élèves de celle-ci sont censés passer l'année suivante
  // (« CP » → « CE1 »), posée par `duplicateClassForNextYear` ou à la main.
  // Sert de base au futur assistant de réinscription (lot 4).
  promotesToId      Int?      @map("promotes_to_id")
  archivedAt        DateTime? @map("archived_at") @db.Timestamp(6)

  school          School               @relation(fields: [schoolId], references: [id])
  // Clé composite : le référent d'une classe est nécessairement de la même
  // école, comme pour TeacherAssignment. `Restrict` explicite : `school_id`
  // n'est pas nullable, un `SetNull` par défaut échouerait à l'exécution.
  // deleteTeacherPermanently détache donc explicitement (homeroomTeacherId à
  // null) avant de supprimer le compte, plutôt que de laisser filtrer
  // l'erreur SQL brute.
  homeroomTeacher User?                @relation(fields: [homeroomTeacherId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Cascade)
  // Cascade : supprimer une année scolaire pour de bon emporte ses classes
  // (voir `deleteSchoolYearPermanently`).
  schoolYear      SchoolYear?          @relation(fields: [schoolYearId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // Auto-relation nommée, composite pour la même raison que `homeroomTeacher` :
  // même contrainte de nullabilité, même parade — `deleteClassPermanently`
  // détache promotesToId (sur les classes qui pointent vers celle-ci) avant
  // de supprimer.
  promotesTo      Class?               @relation("ClassPromotion", fields: [promotesToId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Cascade)
  promotedFrom    Class[]              @relation("ClassPromotion")
  students        Student[]
  assignments     TeacherAssignment[]
  coefficients    SubjectCoefficient[]
  evaluations     Evaluation[]
  attendances     Attendance[]
  enrolledFrom    EnrollmentDecision[] @relation("EnrollmentFrom")
  enrolledTo      EnrollmentDecision[] @relation("EnrollmentTo")

  // Cible des clés étrangères composites de TeacherAssignment.
  @@unique([id, schoolId])
  @@index([schoolId, archivedAt])
  @@index([schoolYearId])
  @@map("classes")
}

// Matières
model Subject {
  id          Int       @id @default(autoincrement())
  schoolId    Int       @map("school_id")
  name        String    @db.VarChar(100)
  coefficient Decimal?  @default(1) @db.Decimal(4, 2) // défaut école, surchargé par SubjectCoefficient
  archivedAt  DateTime? @map("archived_at") @db.Timestamp(6)

  school       School               @relation(fields: [schoolId], references: [id])
  assignments  TeacherAssignment[]
  grades       Grade[]
  coefficients SubjectCoefficient[]
  evaluations  Evaluation[]

  // Cible des clés étrangères composites de TeacherAssignment.
  @@unique([id, schoolId])
  @@index([schoolId, archivedAt])
  @@map("subjects")
}

// Coefficient d'une matière pour une classe donnée.
// La clé composite interdit structurellement le doublon.
model SubjectCoefficient {
  subjectId   Int     @map("subject_id")
  classId     Int     @map("class_id")
  coefficient Decimal @db.Decimal(4, 2)

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([subjectId, classId])
  @@map("subject_coefficients")
}

// Types de note et leur poids — configurables par l'administration de
// l'école (voir gradeType.service.ts), plus seulement les 3 catégories
// historiques (interrogation = 1, devoir = 2, composition = 3, toujours le
// seed par défaut à la création d'une école).
//
// `code` reste un identifiant technique stable (slug dérivé du libellé à la
// création) mais n'est plus comparé en dur nulle part : la logique métier
// s'appuie désormais sur `required` (moyenne publiée seulement si l'élève a
// au moins une note de chaque type obligatoire, voir grading/compute.ts). Le
// bulletin PDF (bulletin/pdf.ts) n'a plus besoin d'un champ dédié : il
// affiche une colonne par type actif de l'école, dans l'ordre de `position`.
model GradeType {
  id         Int       @id @default(autoincrement())
  schoolId   Int       @map("school_id")
  code       String    @db.VarChar(30)
  label      String    @db.VarChar(50)
  weight     Decimal   @db.Decimal(4, 2)
  position   Int       @default(0)
  required   Boolean   @default(false)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  school      School       @relation(fields: [schoolId], references: [id])
  grades      Grade[]
  evaluations Evaluation[]

  @@unique([schoolId, code])
  @@map("grade_types")
}

// Élèves
model Student {
  id         Int       @id @default(autoincrement())
  schoolId   Int       @map("school_id")
  classId    Int       @map("class_id")
  firstName  String    @map("first_name") @db.VarChar(100)
  lastName   String    @map("last_name") @db.VarChar(100)
  birthDate  DateTime? @map("birth_date") @db.Date
  // Optionnel : sert au bulletin (case « Sexe »), jamais requis pour créer
  // un élève — les écoles qui ne le renseignent pas voient juste un champ vide.
  sex        Sex?
  archivedAt DateTime? @map("archived_at") @db.Timestamp(6)

  school              School               @relation(fields: [schoolId], references: [id])
  // Cascade : supprimer une classe pour de bon emporte ses élèves, et donc
  // (via les cascades ci-dessous) leurs notes, présences et liens parents —
  // voir `deleteClassPermanently`.
  class               Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  parents             StudentParent[]
  grades              Grade[]
  attendances         Attendance[]
  enrollmentDecisions EnrollmentDecision[]

  // Cible de la clé étrangère composite de Grade : garantit en base qu'une
  // note et son élève appartiennent à la même école.
  @@unique([id, schoolId])
  @@index([classId, archivedAt])
  @@index([schoolId, archivedAt])
  @@map("students")
}

// Lien élève ↔ parent (un enfant peut avoir plusieurs parents/tuteurs)
//
// `schoolId` est dénormalisé et partagé par les deux clés étrangères
// composites, comme pour TeacherAssignment : la base refuse désormais un
// lien qui mélangerait un élève et un parent de deux établissements. Seul
// `attachParent` (student.service.ts) écrit ici aujourd'hui et vérifie déjà
// les deux côtés — ce garde-fou protège tout futur point d'écriture qui
// oublierait ce contrôle applicatif.
model StudentParent {
  schoolId     Int @map("school_id")
  studentId    Int @map("student_id")
  parentUserId Int @map("parent_user_id")

  student Student @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  parent  User    @relation(fields: [parentUserId, schoolId], references: [id, schoolId], onDelete: Cascade)

  @@id([studentId, parentUserId])
  @@map("student_parents")
}

// Affectation prof ↔ classe ↔ matière
//
// `schoolId` est dénormalisé et partagé par les trois clés étrangères
// composites : la base refuse désormais une affectation qui mélangerait un
// enseignant, une classe et une matière de deux établissements. Sans cela,
// les trois FK étaient indépendantes et seul un contrôle applicatif
// empêchait la ligne croisée — alors que `listMyClasses` en dérive les
// classes qu'un professeur a le droit de voir.
model TeacherAssignment {
  id            Int @id @default(autoincrement())
  schoolId      Int @map("school_id")
  teacherUserId Int @map("teacher_user_id")
  classId       Int @map("class_id")
  subjectId     Int @map("subject_id")

  teacher User    @relation(fields: [teacherUserId, schoolId], references: [id, schoolId], onDelete: Cascade)
  class   Class   @relation(fields: [classId, schoolId], references: [id, schoolId], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId, schoolId], references: [id, schoolId], onDelete: Cascade)
  slots   TimetableSlot[]

  @@unique([teacherUserId, classId, subjectId])
  // Cible de la clé étrangère composite de TimetableSlot.
  @@unique([id, schoolId])
  @@index([schoolId])
  @@map("teacher_assignments")
}

// Jour de semaine d'un créneau d'emploi du temps.
enum Weekday {
  lundi
  mardi
  mercredi
  jeudi
  vendredi
  samedi
  dimanche

  @@map("weekday")
}

// Créneau récurrent de l'emploi du temps : jour de semaine + horaire, pour
// une affectation enseignant×classe×matière. Plusieurs créneaux de la même
// matière le même jour sont possibles (ex. Maths 8h-9h et 14h-15h).
//
// Ne concerne que les classes en mode `notes` — les classes `presence`
// (maternelle/garderie) gardent le flux historique : admin ou référent,
// un appel par jour, sans créneau (voir attendance.service.ts).
model TimetableSlot {
  id                  Int       @id @default(autoincrement())
  schoolId            Int       @map("school_id") // dénormalisé : isolation multi-écoles sans jointure
  teacherAssignmentId Int       @map("teacher_assignment_id")
  dayOfWeek           Weekday   @map("day_of_week")
  // Minutes depuis minuit (0-1439) plutôt que @db.Time : évite toute
  // ambiguïté de fuseau horaire pour comparer deux horaires du même jour —
  // déjà eu ce bug une fois sur "aujourd'hui" calculé en UTC serveur, voir
  // dashboard.service.ts::getAttendanceSummary.
  startMinute         Int       @map("start_minute")
  endMinute           Int       @map("end_minute")
  archivedAt          DateTime? @map("archived_at") @db.Timestamp(6)

  // Cascade : supprimer une affectation emporte ses créneaux *inutilisés*.
  // Un créneau qui a déjà de la présence enregistrée est protégé par
  // Attendance.slot en RESTRICT, qui bloque alors toute la chaîne.
  teacherAssignment TeacherAssignment @relation(fields: [teacherAssignmentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  attendances       Attendance[]

  // Cible de la clé étrangère composite d'Attendance.
  @@unique([id, schoolId])
  @@index([schoolId, dayOfWeek, archivedAt])
  @@index([teacherAssignmentId, dayOfWeek, archivedAt])
  @@map("timetable_slots")
}

// Appareils des utilisateurs (tokens push FCM) — un parent peut en avoir plusieurs
model Device {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  fcmToken  String    @unique @map("fcm_token") @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("devices")
}

// Notes.
// Le poids d'une note vient UNIQUEMENT de GradeType.weight : il n'y a
// volontairement pas de colonne `coefficient` ici (source de vérité unique).
model Grade {
  id            Int       @id @default(autoincrement())
  schoolId      Int       @map("school_id") // dénormalisé : isolation multi-écoles sans jointure
  studentId     Int       @map("student_id")
  evaluationId  Int       @map("evaluation_id")
  subjectId     Int       @map("subject_id")
  gradeTypeId   Int       @map("grade_type_id")
  termId        Int       @map("term_id")
  teacherUserId Int?      @map("teacher_user_id")
  value         Decimal   @db.Decimal(5, 2)
  // Recopié depuis l'évaluation, qui en est la source de vérité. Dénormalisé
  // ici comme school_id l'est plus haut : le calcul des moyennes lit la note
  // sans jointure sur l'évaluation. Toute écriture passe par le barème de
  // l'évaluation, ce qui garde les deux alignés.
  maxValue      Decimal   @default(20) @map("max_value") @db.Decimal(5, 2)
  comment       String?   @db.Text // commentaire du prof, visible par le parent
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  // Clé composite : impossible d'enregistrer une note dont le school_id
  // dénormalisé diverge de celui de l'élève. Sans cela, la colonne qui porte
  // tout le filtrage d'isolation ne serait garantie par rien.
  // Cascade sur subject/term comme sur student/evaluation : supprimer une
  // matière ou une période pour de bon emporte les notes qui s'y rattachent
  // (voir `deleteSubjectPermanently`, `deleteTermPermanently`).
  student    Student    @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  gradeType  GradeType  @relation(fields: [gradeTypeId], references: [id])
  term       Term       @relation(fields: [termId], references: [id], onDelete: Cascade)
  teacher    User?      @relation(fields: [teacherUserId], references: [id])

  // Une seule note par élève et par évaluation : l'ambiguïté « plusieurs notes
  // du même type » disparaît, l'identité d'une note étant désormais son
  // évaluation, non son type.
  @@unique([evaluationId, studentId])
  @@index([studentId, termId]) // porte tout le calcul des moyennes
  @@index([schoolId, createdAt]) // porte le dashboard admin
  @@index([subjectId, termId])
  @@index([teacherUserId, createdAt]) // porte la fiche enseignant (notes récentes + total saisi)
  @@map("grades")
}

// Une évaluation concrète : « Interro du 12/09 », « Composition du 2e trimestre ».
//
// C'est elle qui permet plusieurs notes du même type dans une même période :
// deux interrogations sont deux évaluations distinctes, chacune portant son
// libellé, sa date et son barème. Le poids reste porté par le type de note.
model Evaluation {
  id            Int       @id @default(autoincrement())
  schoolId      Int       @map("school_id")
  classId       Int       @map("class_id")
  subjectId     Int       @map("subject_id")
  gradeTypeId   Int       @map("grade_type_id")
  termId        Int       @map("term_id")
  teacherUserId Int?      @map("teacher_user_id")
  label         String    @db.VarChar(120)
  date          DateTime? @db.Date
  maxValue      Decimal   @default(20) @map("max_value") @db.Decimal(5, 2)
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  // Comme Grade s'ancre à son école via l'élève, l'évaluation s'y ancre via sa
  // classe : la clé composite interdit une évaluation dont le school_id diverge
  // de celui de la classe.
  // Cascade sur subject/term comme sur class : supprimer une matière ou une
  // période pour de bon emporte ses évaluations, et donc les notes qui s'y
  // rattachent (Grade.evaluation est déjà en cascade).
  class     Class     @relation(fields: [classId, schoolId], references: [id, schoolId], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  gradeType GradeType @relation(fields: [gradeTypeId], references: [id])
  term      Term      @relation(fields: [termId], references: [id], onDelete: Cascade)
  teacher   User?     @relation(fields: [teacherUserId], references: [id])
  grades    Grade[]

  @@index([classId, subjectId, termId])
  @@index([schoolId])
  @@map("evaluations")
}

enum AttendanceStatus {
  present
  absent
  late

  @@map("attendance_status")
}

// Présence : un statut par élève et par jour (plan maternelle/garderie, mais
// utilisable par toute classe). `classId` est figé à la saisie, comme
// `Evaluation.classId` pour les notes : déplacer un élève vers une autre
// classe ne doit pas réécrire l'historique de présence déjà enregistré.
model Attendance {
  id               Int              @id @default(autoincrement())
  schoolId         Int              @map("school_id") // dénormalisé : isolation multi-écoles sans jointure
  studentId        Int              @map("student_id")
  classId          Int              @map("class_id")
  // Créneau d'origine pour les classes mode `notes` — `null` pour les
  // classes mode `presence`, qui gardent le flux historique (un appel/jour,
  // admin ou référent, sans créneau). Comme `classId`, figé à la saisie :
  // retirer un créneau de l'emploi du temps ne doit jamais réécrire une
  // présence déjà enregistrée (voir TimetableSlot.slot en RESTRICT).
  slotId           Int?             @map("slot_id")
  date             DateTime         @db.Date
  status           AttendanceStatus
  comment          String?          @db.Text
  recordedByUserId Int?             @map("recorded_by_user_id")
  createdAt        DateTime?        @default(now()) @map("created_at") @db.Timestamp(6)

  // Comme Grade s'ancre à son école via l'élève, la présence s'y ancre aussi
  // via la classe : les deux clés composites interdisent un enregistrement
  // dont le school_id dénormalisé diverge de celui de l'élève ou de la classe.
  student    Student        @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  class      Class          @relation(fields: [classId, schoolId], references: [id, schoolId], onDelete: Cascade)
  slot       TimetableSlot? @relation(fields: [slotId, schoolId], references: [id, schoolId], onDelete: Restrict, onUpdate: Cascade)
  recordedBy User?          @relation(fields: [recordedByUserId], references: [id])

  // Un seul statut par élève, par jour, et par créneau. Prisma ne sait pas
  // exprimer un index unique PARTIEL (WHERE slot_id IS [NOT] NULL) :
  // @@unique([studentId, date, slotId]) laisserait passer deux lignes à
  // slot_id NULL comme non-dupliquées (NULL <> NULL en SQL), ce qui
  // permettrait deux statuts le même jour pour une classe mode `presence`.
  // Les deux vrais index uniques sont posés à la main dans la migration SQL.
  @@index([studentId, date, slotId])
  @@index([classId, date]) // porte la feuille de présence d'une classe pour un jour
  @@index([slotId, date]) // porte la feuille de présence d'un créneau pour un jour
  @@index([recordedByUserId, date]) // porte la fiche enseignant (présences récentes)
  @@map("attendances")
}

enum EnrollmentDecisionType {
  promotion
  redoublement
  autre

  @@map("enrollment_decision_type")
}

// Trace d'une réinscription : un élève déplacé de `fromClass` vers `toClass`
// à la préparation d'une rentrée, avec la décision qui l'explique (monte,
// redouble, ou autre). Pur historique — déplacer l'élève se fait sur
// `Student.classId`, cette table ne fait qu'en garder la mémoire, pour qu'un
// directeur retrouve qui a redoublé et vers où chacun est parti.
model EnrollmentDecision {
  id              Int                    @id @default(autoincrement())
  schoolId        Int                    @map("school_id") // dénormalisé : isolation multi-écoles sans jointure
  studentId       Int                    @map("student_id")
  fromClassId     Int                    @map("from_class_id")
  toClassId       Int                    @map("to_class_id")
  decision        EnrollmentDecisionType
  decidedByUserId Int?                   @map("decided_by_user_id")
  createdAt       DateTime?              @default(now()) @map("created_at") @db.Timestamp(6)

  // Comme Grade et Attendance, ancré à son école via l'élève ; les deux
  // classes le sont pareillement, chacune via sa propre clé composite.
  student   Student @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  fromClass Class   @relation("EnrollmentFrom", fields: [fromClassId, schoolId], references: [id, schoolId], onDelete: Cascade)
  toClass   Class   @relation("EnrollmentTo", fields: [toClassId, schoolId], references: [id, schoolId], onDelete: Cascade)
  decidedBy User?   @relation(fields: [decidedByUserId], references: [id])

  @@index([fromClassId, createdAt]) // porte l'historique d'une classe qui a préparé sa rentrée
  @@index([studentId])
  @@map("enrollment_decisions")
}

// Système de notifications : annonces, convocations, incidents destinées aux parents
// Une notification peut cibler un parent unique, tous les parents d'une classe, ou toute l'école.
// Elle déclenche un push FCM immédiate et reste affichée jusqu'à marquage « lu ».

enum NotificationType {
  annonce     // Basse urgence (réunion parents, info générale)
  convocation // Moyenne urgence (mauvaise note, avertissement)
  incident    // Haute urgence (incident disciplinaire, danger)

  @@map("notification_type")
}

enum NotificationResourceType {
  grade      // Mauvaise note
  student    // Incident sur élève
  attendance // Absence
  enrollment // Inscription
  other

  @@map("notification_resource_type")
}

enum NotificationTargetType {
  parent          // Parent unique
  class_parents   // Tous les parents d'une classe
  school_parents  // Tous les parents de l'école

  @@map("notification_target_type")
}

// Notification créée par admin ou enseignant, envoyée à un ou plusieurs parents
model Notification {
  id               Int                      @id @default(autoincrement())
  schoolId         Int                      @map("school_id")
  creatorUserId    Int                      @map("creator_user_id")
  title            String                   @db.VarChar(200)
  body             String                   @db.Text
  type             NotificationType
  severity         Int                      @default(0) // 0=annonce, 1=convocation, 2=incident
  targetType       NotificationTargetType   @map("target_type")
  targetId         Int?                     @map("target_id") // classId ou parentUserId selon targetType
  resourceType     NotificationResourceType? @map("resource_type")
  resourceId       Int?                     @map("resource_id")
  metadata         Json?
  createdAt        DateTime?                @default(now()) @map("created_at") @db.Timestamp(6)
  archivedAt       DateTime?                @map("archived_at") @db.Timestamp(6)

  school    School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  creator   User                    @relation(fields: [creatorUserId], references: [id], onDelete: Restrict)
  recipients NotificationRecipient[]

  @@index([schoolId, createdAt])
  @@index([schoolId, type])
  @@index([creatorUserId])
  @@map("notifications")
}

// Liaison notification ↔ parent destinataire, avec marquage « lu »
// Un parent peut recevoir la même notification qu'un autre, indépendamment
model NotificationRecipient {
  id               Int       @id @default(autoincrement())
  schoolId         Int       @map("school_id")
  notificationId   Int       @map("notification_id")
  parentUserId     Int       @map("parent_user_id")
  readAt           DateTime? @map("read_at") @db.Timestamp(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  archivedAt       DateTime? @map("archived_at") @db.Timestamp(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  parent       User         @relation("NotificationRecipients", fields: [parentUserId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([notificationId, parentUserId])
  @@index([schoolId, parentUserId, readAt])
  @@index([notificationId])
  @@map("notification_recipients")
}
