#!/bin/sh
#
# Interdit le push direct sur les branches protégées.
#
# GitHub refuse d'appliquer une protection de branche sur un dépôt privé sans
# plan payant : ce hook joue le même rôle côté poste de travail. Il est
# versionné (.githooks) et activé automatiquement par le script `prepare` de
# package.json, donc actif après un simple `npm install`.
#
# Contournement volontaire, à n'utiliser qu'en connaissance de cause :
#   GESNOTES_ALLOW_DIRECT_PUSH=1 git push origin dev

PROTECTED="main dev"

if [ "$GESNOTES_ALLOW_DIRECT_PUSH" = "1" ]; then
  echo "pre-push : contournement explicite (GESNOTES_ALLOW_DIRECT_PUSH=1)." >&2
  exit 0
fi

# stdin : <ref_locale> <sha_local> <ref_distante> <sha_distant>
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ -z "$remote_ref" ] && continue

  branch=${remote_ref#refs/heads/}

  for protected in $PROTECTED; do
    if [ "$branch" = "$protected" ]; then
      echo "" >&2
      echo "  ✖ Push direct sur '$branch' refusé." >&2
      echo "" >&2
      echo "  Cette branche n'accepte que des pull requests :" >&2
      echo "      git checkout -b feat/ma-fonctionnalite" >&2
      echo "      git push -u origin feat/ma-fonctionnalite" >&2
      echo "      gh pr create --base $branch" >&2
      echo "" >&2
      exit 1
    fi
  done
done

exit 0
